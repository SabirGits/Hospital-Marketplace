PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=some_long_random_secret_string

# Admin account is created automatically the first time the server connects
# to the database (see utils/bootstrapAdmin.js). Change these before your
# first run, or after — but note changing them later does NOT update an
# already-created admin record, only creates a new one if none exists yet.
ADMIN_EMAIL=admin@hospitalmarketplace.in
ADMIN_PASSWORD=Admin@123

# Optional — only needed if you want the "Continue with Google" button on
# the frontend to actually work. Must be the SAME Client ID as the
# frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
