# Copy this file to ".env" (same folder) and adjust the value if needed.
# ".env" is already in .gitignore-worthy territory — don't commit real secrets.

# Base URL of your Express backend's API routes.
# Must match the PORT your backend's .env uses, plus the "/api" prefix
# that server.js mounts routes under (app.use("/api/auth", ...) etc).
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In (optional). Get a free OAuth Client ID from
# https://console.cloud.google.com/apis/credentials — create an "OAuth client ID"
# of type "Web application", add http://localhost:5173 (and your real domain later)
# under "Authorized JavaScript origins". Paste the Client ID below.
# Without this, the "Continue with Google" button explains what's missing instead
# of silently failing.
VITE_GOOGLE_CLIENT_ID=
